        ]
    },
    {
        "id": "f3911989ab46b393",
        "type": "function",
        "z": "19ce8e091ec31145",
        "g": "b6b83a14f63600be",
        "name": "update ui 3",
        "func": "const map = (num, inMin, inMax, outMin, outMax) => {\n    return Math.round(((num - inMin) * (outMax - outMin)) / (inMax - inMin) + outMin);\n}\n\nmsg.payload = map(msg.payload.d.value, 0, 255, 10, 60);\n\nflow.set('target', msg.payload);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
