        "g": "b6b83a14f63600be",
        "name": "automate",
        "func": "let temperature = flow.get('temperature') || 20;\nlet target = flow.get('target') || 15;\n\nlet evt1 = {d:{}};\nif (target > temperature) {\n    evt1.d.valve = 'on';\n} else {\n    evt1.d.valve = 'off';  \n}\nreturn {payload : evt1};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 260,
